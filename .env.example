# Server environment
NODE_ENV=production
PORT=3000

# Application URL (used for CORS, email links, etc.)
APP_URL=https://your-domain.railway.app

# Auth credentials (REQUIRED - replace and rotate regularly)
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=your-secure-password
AUTH_NAME=Your Name

# API Keys
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_MAPS_API_KEY=

# Turso Database (production)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
